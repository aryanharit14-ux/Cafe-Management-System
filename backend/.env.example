PORT=5002
# Required: Atlas database-user credentials, URL-encoded in the URI.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@YOUR-CLUSTER.mongodb.net/juniper_cafe?retryWrites=true&w=majority
# Optional override of the database name in the URI:
# MONGO_DB_NAME=juniper_cafe
# Optional initial staff setup. Prefer `npm run admin` instead.
# ADMIN_EMAIL=manager@example.com
# ADMIN_PASSWORD=replace-with-a-long-unique-password

# Razorpay: start with test-mode keys. Keep secrets on the backend only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
